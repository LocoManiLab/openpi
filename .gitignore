# LocoManiLab: never version weights, envs, or editor/backup droppings
.venv/
checkpoints/
assets/*/[0-9]*/
*.bak
*.orig
*.locomanilab-bak
# Older local backups remain excluded.
*.soma-bak
*.mine
__pycache__/
*.pyc
wandb/

# LocoManiLab: keep the fork small and reviewable.
# .local/ is a stray toolchain copy that came in via rsync (a 58 MB `uv` binary),
# not part of openpi. third_party/ is upstream's vendored sim assets (200 MB+ of
# meshes/textures) -- reachable from upstream, no reason to duplicate in our fork.
.local/
third_party/
